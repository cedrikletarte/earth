# ── Vite (baked at build time) ────────────────────────────────────────────────

# Which basemap backend the app talks to at runtime: "pmtiles" (default,
# reads the baked archives — fast, but only detailed where you've baked) or
# "tileserver" (live rasterizing, full planet coverage at native zoom, no
# bake step, but rendered on every request). See README "Baking the basemap
# (PMTiles)" for the tradeoff. Requires a rebuild to take effect.
VITE_BASEMAP_SOURCE=pmtiles

# Base URL of your TileServer-GL instance (CORS must be enabled in config.json)
# Needed for re-baking styles via scripts/bake-pmtiles.sh, and at app runtime
# only when VITE_BASEMAP_SOURCE=tileserver.
VITE_TILESERVER_URL=http://localhost:8085

# Base URL of the pmtiles-serve instance — this is what the app actually
# fetches the basemap from at runtime. Use your machine's IP so it works
# across devices on the network.
VITE_PMTILES_URL=http://localhost:8087

# Base URL of your Nominatim instance
VITE_NOMINATIM_BASE_URL=http://localhost:8086

# ── Docker Compose ────────────────────────────────────────────────────────────

# Absolute path to the folder containing your .mbtiles files (TileServer-GL)
TILESERVER_DATA_PATH=/path/to/your/mbtiles

# Absolute path to the folder containing your .osm.pbf file (Nominatim)
NOMINATIM_DATA_PATH=/path/to/your/nominatim-data

# Name of the .osm.pbf file to import into Nominatim
NOMINATIM_PBF_FILE=region-latest.osm.pbf

# Nominatim internal database password
NOMINATIM_PASSWORD=changeme
